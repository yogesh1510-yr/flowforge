POSTGRES_DB=flowforge
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=flowforge_dev_only
FLOWFORGE_ENV=dev

# Host ports are configurable so dev, non-prod, and prod stacks can share a host.
API_HOST_PORT=8000
POSTGRES_HOST_PORT=5434
KAFKA_HOST_PORT=19092
KAFKA_ADVERTISED_HOST=localhost
CONNECT_HOST_PORT=8083
AIRFLOW_HOST_PORT=8080

# Local Airflow UI credentials. Change these before sharing the environment.
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=flowforge_admin_only
AIRFLOW_ADMIN_EMAIL=admin@example.com
